# Copie para .env. Valores de DESENVOLVIMENTO: troque tudo em staging/produção.
NODE_ENV=development
PORT=3000

# PGlite local (pnpm db:dev) ou Postgres do docker-compose (porta 5432).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-isto-por-um-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
# true em HTTPS (staging/produção)
COOKIE_SECURE=false

# local = disco (apps/api/.data/storage) | s3 = MinIO/S3/R2
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=simulador
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# Senha dos usuários de demonstração criados pelo seed (entre aspas: # inicia comentário)
SEED_PASSWORD="Simulador#2026"

# Worker de reconstrução (services/worker). Sem WORKER_URL, a reconstrução usa o template demonstrativo.
# WORKER_URL=http://127.0.0.1:8000
# WORKER_SECRET=mesmo-valor-do-worker-com-32-caracteres-ou-mais
